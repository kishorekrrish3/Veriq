# ==============================================================================
# VERIQ — Environment Configuration
# Tagline: Code is generated. Proof is earned.
# ==============================================================================

# Application Environment (development, testing, production)
APP_ENV=development
HOST=127.0.0.1
PORT=8000
DEBUG=false

# Persistence
DATABASE_URL=sqlite:///./data/veriq.db
DATA_DIR=./data

# AI Infrastructure — Nebius Token Factory (OpenAI Compatible)
# Set your real Nebius API key here to enable live inference.
# When left empty, VERIQ operates in Recorded Replay Mode.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1

# NVIDIA Nemotron Model Routing Tiers
# Fast Tier: Low latency, planning, simple transformations
NEBIUS_MODEL_FAST=nvidia/nemotron-mini-4b-instruct

# Standard Tier: Primary code synthesis and structured reasoning
NEBIUS_MODEL_STANDARD=nvidia/Llama-3.1-Nemotron-70B-Instruct-HF

# Escalation Tier: High-capacity repair, complex multi-file regressions
NEBIUS_MODEL_ESCALATION=nvidia/nemotron-4-340b-instruct

# Tavily Research API
# Set your Tavily API key here to enable live web and documentation research.
TAVILY_API_KEY=

# Execution Flags
ENABLE_LIVE_INFERENCE=false
ENABLE_LIVE_RESEARCH=false

# Bounded Execution & Safety Budgets
MAX_REPAIR_ATTEMPTS=1
MAX_EXECUTION_SECONDS=30
MAX_PATCH_FILES=10
MAX_PATCH_BYTES=50000

# Sandbox Configuration
# When Docker is available, uses the isolated container.
# Otherwise, safely falls back to restricted process isolation.
SANDBOX_DOCKER_IMAGE=veriq-sandbox:latest
ALLOW_FALLBACK_SANDBOX=true
